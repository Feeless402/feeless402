{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.feeless402/nano-pay",
  "description": "Pay for x402-priced APIs with feeless, sub-second Nano (XNO) micropayments from a local wallet.",
  "version": "0.2.5",
  "websiteUrl": "https://feeless402.com",
  "repository": {
    "url": "https://github.com/Feeless402/feeless402",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "feeless402",
      "version": "0.2.5",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "run the stdio MCP server"
        }
      ]
    }
  ]
}
